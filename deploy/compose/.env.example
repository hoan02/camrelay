# Copy to .env. Keep this file private and provide a strong base64 32-byte key
# when config.json enables SQLite migration.
CAMRELAY_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# React console is the production default; use /opt/camrelay/static for the
# legacy rollback console.
CAMRELAY_WEB_ROOT=/opt/camrelay/apps/web/dist
# Used only with docker-compose.webrtc.yml.
CAMRELAY_WEBRTC_ENABLED=true
CAMRELAY_WEBRTC_UDP_PORT=8189
