# Required only when database_enabled=true and legacy provider/camera secrets
# need to be imported. Generate and store this outside the repository.
CAMRELAY_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Docker defaults to the React console. Set this to /opt/camrelay/static to
# roll back to the legacy console inside the image.
CAMRELAY_WEB_ROOT=/opt/camrelay/apps/web/dist
# WebRTC is an explicit LAN-only opt-in. It requires the compose override.
CAMRELAY_WEBRTC_ENABLED=false
# Host UDP port used for MediaMTX ICE; never put this in an RTSP URL.
CAMRELAY_WEBRTC_UDP_PORT=8189
